# Set once by the maintainer and committed with the demo (this file holds no secrets).
# Where the three images are published, without the image name. For GitHub Container Registry: ghcr.io/<github user or organisation>. Upper case is fine: the start scripts lower-case it.
DEMO_IMAGE_PREFIX=ghcr.io/hansolo
# Image tag; the publishing workflows push "salesdemo" from the salesdemo branch
DEMO_IMAGE_TAG=salesdemo
# Start values of the three demo switches in DuckInsurance (sidebar, admin only): on or off.
# For the story "plain Jakarta EE app first", set all three to off and switch them on during the demo.
DUCK_ASSISTANT=on
DUCK_FRAUD_AGENT=on
DUCK_AGENTS_TAB=on
