# Set once by the maintainer and committed with the demo (this file holds no secrets).
# Where the three images are published, without the image name. For GitHub Container Registry: ghcr.io/<github user or organisation, lower case>
DEMO_IMAGE_PREFIX=ghcr.io/HanSolo
# Image tag; the publishing workflows push "salesdemo" from the salesdemo branch
DEMO_IMAGE_TAG=salesdemo
