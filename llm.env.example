# Language model of the Duck agents demo, used by all three applications.
# The start script copies this file to llm.env the first time. Edit llm.env, save it, and start the demo again.
# Keep llm.env private: it holds the API key. Never send it around or commit it.
#
# Exactly one of the three blocks below must be active (lines without # in front).

# ---- Option B (active): Claude through the Anthropic API ----
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=PASTE-THE-CLAUDE-MODEL-NAME-HERE
LLM_API_KEY=PASTE-YOUR-API-KEY-HERE

# ---- Option A: a local Ollama on this computer (no internet, needs a strong laptop) ----
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=qwen3.8:27b
# LLM_API_KEY=ollama

# ---- Option C: a service in the OpenAI format (OpenAI, Groq, OpenRouter, Mistral, ...) ----
# The address includes /v1, for example https://api.openai.com/v1, https://api.groq.com/openai/v1, https://openrouter.ai/api/v1
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model name of that service>
# LLM_API_KEY=<key of that service>

# Optional: answer length. anthropic: default 4096. openai: no limit unless set.
# LLM_MAX_TOKENS=4096
